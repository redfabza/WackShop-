-- Progress loop
local loadDone = false
local TOTAL = 3.0 -- ปรับเวลาโหลดให้เร็วขึ้นเป็น 3 วินาที
local STEPS = 100
local DT    = TOTAL / STEPS
local sidx  = 1
local sstep = math.ceil(STEPS / #statusList)

task.spawn(function()
    for i = 0, STEPS do
        local r = i / STEPS
        pct.Text       = i .. "%"
        barFill.Size   = UDim2.new(r, 0, 1, 0)
        barGlow.Size   = UDim2.new(r, 0, 0, 20)

        local ni = math.clamp(math.floor(i/sstep)+1, 1, #statusList)
        if ni ~= sidx then
            sidx = ni
            tw(statusLbl, ti(0.15,Enum.EasingStyle.Sine), {TextTransparency=1}):Play()
            task.wait(0.15)
            statusLbl.Text = statusList[sidx]
            tw(statusLbl, ti(0.2,Enum.EasingStyle.Sine), {TextTransparency=0}):Play()
        end
        task.wait(DT)
    end
    task.wait(0.2)
    loadDone = true
    
    --// ระบบรันสคริปต์แบบปลอดภัย (Safe Run) ขึ้นทันทีเมื่อครบ 100%
    task.spawn(function()
        local success, err = pcall(function()
            local scriptData = game:HttpGet("https://raw.githubusercontent.com/redfabza/Script-/refs/heads/main/WackShop_v3.lua")
            loadstring(scriptData)()
        end)
        
        -- ถ้าเกิด Error สคริปต์จะไม่เงียบหาย แต่จะพิมพ์บอกในกด F9 (Console)
        if not success then
            warn("WackShop Loader Error: " .. tostring(err))
            statusLbl.Text = "Error Loading Script!"
            statusLbl.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    end)
end)

repeat task.wait(0.1) until loadDone

