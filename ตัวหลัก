local RING_Y = 0.30
local function makeRing(sw, thick, trans)
    local f = new("Frame", {
        AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.new(0.5,0,RING_Y,0),
        Size=UDim2.new(sw,0,sw,0),
        BackgroundTransparency=1, ZIndex=6,
    }, bg)
    new("UIAspectRatioConstraint", {
        AspectRatio=1, AspectType=Enum.AspectType.FitWithinMaxSize,
        DominantAxis=Enum.DominantAxis.Width,
    }, f)
    new("UICorner", {CornerRadius=UDim.new(1,0)}, f)
    local s = new("UIStroke", {Thickness=thick, Color=Color3.fromRGB(0,195,255), Transparency=trans}, f)
    return f, s
end

local outerRing, outerStroke = makeRing(0.48, 2,  0.4)
