local function ti(t, s, d)
    return TweenInfo.new(t, s or Enum.EasingStyle.Quint, d or Enum.EasingDirection.Out)
end
local function tw(obj, info, goal) return TS:Create(obj, info, goal) end
local function new(cls, props, parent)
    local i = Instance.new(cls)
    for k,v in pairs(props) do i[k] = v end
    if parent then i.Parent = parent end
    return i
end

